[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ProviderName%
DriverVer   = 10/01/2026,0.1.0.0
CatalogFile = BDFRSentinelFilter.cat

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,ServiceInstall

[DriverCopyFiles]
BDFRSentinelFilter.sys

[ServiceInstall]
DisplayName    = %ServiceDisplayName%
Description    = %ServiceDescription%
ServiceBinary  = %12%\BDFRSentinelFilter.sys
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Anti-Virus"
AddReg         = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%DefaultInstance%","Altitude",0x00000000,%Altitude%
HKR,"Parameters\Instances\%DefaultInstance%","Flags",0x00010001,0

[Strings]
ProviderName       = "BDFR"
ServiceName        = "BDFRSentinelFilter"
ServiceDisplayName = "BDFR Sentinel Minifilter"
ServiceDescription = "Pre-execution file policy minifilter for BDFR Sentinel"
DefaultInstance    = "BDFR Sentinel Instance"
; Test/development altitude only. Public distribution requires an
; officially assigned Microsoft minifilter altitude.
Altitude           = "370030"
